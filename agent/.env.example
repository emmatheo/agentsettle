# Copy to .env and fill in. NEVER commit .env — .gitignore already excludes it.

ARC_RPC_URL=https://rpc.testnet.arc.network

# Cold key: deploys wallets, funds them, sets policy. Fund from faucet.circle.com
OWNER_PRIVATE_KEY=

# Hot key: the autonomous agent signs with this. Needs a small USDC balance for
# gas (send it ~$1 from the owner key). Compromise of this key is bounded by
# the on-chain policy — that's the whole point of AgentSettle.
AGENT_PRIVATE_KEY=

# From `forge script script/Deploy.s.sol` output:
AGENTSETTLE_FACTORY=
AGENTSETTLE_SETTLEMENT=
AGENTSETTLE_REGISTRY=

# From `npm run setup` output:
TREASURY_WALLET=
WORKER_WALLET=
